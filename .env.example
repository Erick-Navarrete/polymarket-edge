# Polymarket Edge — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the .env file

# === TRADING MODE ===
# Set to true ONLY when ready for live execution
LIVE_MODE=false
# Shadow mode: connect to live data feeds but paper-trade only.
# Use to validate strategies against real-time prices before going live.
SHADOW_MODE=false

# === WALLET ===
POLYGON_WALLET_ADDRESS=0x_your_address_here
POLYGON_WALLET_PRIVATE_KEY=your_private_key_here

# === POLYMARKET API ===
POLYMARKET_API_KEY=your_api_key
POLYMARKET_API_SECRET=your_api_secret
POLYMARKET_API_PASSPHRASE=your_passphrase

# === KALSHI API (for cross-platform arbitrage) ===
KALSHI_API_KEY=your_kalshi_key
KALSHI_API_SECRET=your_kalshi_secret

# === DATA SOURCES ===
BINANCE_API_KEY=your_binance_key
BINANCE_API_SECRET=your_binance_secret
COINBASE_API_KEY=your_coinbase_key
COINBASE_API_SECRET=your_coinbase_secret

# === AI / LLM ===
OPENAI_API_KEY=your_openai_key

# === DATABASE ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=polymarket_edge
POSTGRES_USER=polymarket
POSTGRES_PASSWORD=changeme

# === REDIS ===
REDIS_HOST=localhost
REDIS_PORT=6379

# === RISK LIMITS ===
MAX_DAILY_LOSS_PCT=5
MAX_MONTHLY_LOSS_PCT=15
MAX_DRAWDOWN_PCT=25
MAX_POSITION_SIZE_USD=500
MAX_TOTAL_EXPOSURE_USD=5000

# === MONITORING ===
GRAFANA_ADMIN_PASSWORD=admin
SLACK_WEBHOOK_URL=
